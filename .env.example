# Alchemy RPC 주소 (키 제외, 필수)
# 예) https://eth-sepolia.g.alchemy.com/v2
ALCHEMY_URL=
# ALCHEMY_URL 의 체인 ID (필수). 예) 이더리움 메인넷 1, Sepolia 11155111
CHAIN_ID=

# Alchemy API 키 (필수)
ALCHEMY_API_KEY=
# 메인 키 요청이 실패하면(키 오류, 사용량 초과 등) 대신 쓸 키. 비우면 메인 키만 쓴다
ALCHEMY_SUB_API_KEY=

# polling-block 이 새 블록을 확인하는 간격(ms). ALCHEMY_WS_URL 이 비어 있을 때만 쓴다
POLL_INTERVAL_MS=6000
# polling-block 이 새 블록을 바로 알기 위한 웹소켓 주소 (키 제외, ALCHEMY_API_KEY 를 그대로 쓴다)
# 예) wss://eth-sepolia.g.alchemy.com/v2  비우면 POLL_INTERVAL_MS 마다 HTTP 폴링만 한다
ALCHEMY_WS_URL=
# 웹소켓을 쓸 때 끊김에 대비해 노드에 최신 블록을 물어보는 간격(ms)
WS_FALLBACK_INTERVAL_MS=60000
# polling-deposit 이 확인할 블록이 쌓였는지 DB 를 보는 간격(ms). Alchemy 요청과는 상관없다 (eth_getLogs 는 쌓였을 때만)
DEPOSIT_POLL_INTERVAL_MS=10000
# 최신 블록에서 이만큼 뒤의 블록까지만 입금을 확인한다 (10 = 약 2분). reorg 로 입금이 사라지는 것 대비
DEPOSIT_CONFIRMATIONS=10
# polling-deposit: 로그 확인 안 된 블록이 이만큼 쌓이면 eth_getLogs 한 번으로 확인한다 (Alchemy 무료 플랜은 최대 10)
DEPOSIT_SCAN_BATCH=10

# DB (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=chonk

# API 서버
# development | test | production (production 이면 Swagger 꺼짐)
NODE_ENV=development
PORT=3000
# 게임 화면 소켓(Socket.IO)에 붙을 수 있는 프론트 주소 (쉼표로 여러 개). 브라우저가 소켓만 백엔드에 직접 붙는다
SOCKET_CORS_ORIGINS=http://localhost:3001
# JWT 서명 키 (32자 이상 무작위 문자열, 유출 금지)
# 생성 예) node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 액세스 토큰 유효 기간(초)
JWT_EXPIRES_IN=3600
# 리프레시 토큰 유효 기간(초). 기본 14일
JWT_REFRESH_EXPIRES_IN=1209600

# 컨트랙트 배포 (npm run cli -- sweep-contract-deploy / erc20-mint 에서만 사용)
# 배포 계정 프라이빗 키. 이 계정이 SweepFactory 와 테스트 토큰(MintableToken)의 owner 가 된다. 절대 유출 금지
DEPLOYER_PRIVATE_KEY=
# sweep 한 돈이 모이는 주소
SWEEP_TREASURY_ADDRESS=
